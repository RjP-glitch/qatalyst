# Copy this file to .env and fill in the values

# Database
DB_HOST=localhost
DB_NAME=evaluation_db
DB_USER=root
DB_PASS=
DB_PORT=3306

# Required application secret
FILE_ENCRYPTION_KEY=your_strong_key_here

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="QRES Dashboard"

# AI provider keys
OPENAI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# OCR runtime binaries (optional overrides)
TESSERACT_BIN=
GHOSTSCRIPT_BIN=
